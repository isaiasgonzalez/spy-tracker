#!/usr/bin/env bash
# Lanzador independiente: usa Python y la autenticación normal de Git.
set -euo pipefail

repo=''
python_command=''
pause=true
old_base=''
while (($#)); do
  case "$1" in
    --repo) repo=${2:?Falta la ruta del repositorio}; shift 2 ;;
    --python) python_command=${2:?Falta el ejecutable de Python}; shift 2 ;;
    --no-pause) pause=false; shift ;;
    --help)
      printf '%s\n' 'Uso: Actualizar-Pesos-Git [--repo CARPETA] [--python PYTHON] [--no-pause]' \
        'Lee spy500.csv, ejecuta script.py pesos, recalcula impactos y hace commit/push a main.'
      exit 0 ;;
    *) printf 'Opción desconocida: %s\n' "$1" >&2; exit 1 ;;
  esac
done

finish() {
  status=$?
  if [[ -n "$old_base" ]]; then rm -f -- "$old_base"; fi
  if ((status != 0)); then
    printf '\nNo se completó la publicación. Tus archivos y commits locales se conservan.\n' >&2
    printf 'Si Git detectó cambios concurrentes, sincronizá main y volvé a ejecutar.\n' >&2
  fi
  if "$pause" && [[ -t 0 ]]; then
    read -r -p 'Presioná Enter para cerrar…' || true
  fi
  exit "$status"
}
trap finish EXIT

folder=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
if [[ -z "$repo" && -f "$folder/script.py" ]]; then
  repo=$folder
fi
if [[ -z "$repo" ]]; then
  read -r -p 'Ruta de tu copia local de spy-tracker: ' repo
fi
cd -- "$repo"
repo=$(pwd)
command -v git >/dev/null || { printf 'Falta Git.\n' >&2; exit 1; }
[[ $(git rev-parse --show-toplevel) == "$repo" ]] || { printf 'Elegí la raíz del repositorio.\n' >&2; exit 1; }
[[ $(git branch --show-current) == main ]] || { printf 'El repositorio debe estar en la rama main.\n' >&2; exit 1; }
for file in script.py weights.py spy500.csv SPY_data.json; do
  [[ -f "$file" ]] || { printf 'Falta %s en el repositorio.\n' "$file" >&2; exit 1; }
done
git diff --cached --quiet || { printf 'Hay cambios preparados para otro commit. Conservándolos; no se continúa.\n' >&2; exit 1; }
# No mezclar ediciones ajenas al CSV y los archivos generados.
while IFS= read -r -d '' file; do
  case "$file" in
    spy500.csv|SPY_componentes_base.json|SPY_data.json) ;;
    *) printf 'Hay cambios en %s. Guardalos antes de publicar pesos.\n' "$file" >&2; exit 1 ;;
  esac
done < <(git diff --name-only -z)
git var GIT_AUTHOR_IDENT >/dev/null
printf 'Sincronizando main…\n'
git fetch origin main
git merge --ff-only origin/main
[[ $(git rev-parse HEAD) == "$(git rev-parse origin/main)" ]] || {
  printf 'Hay commits locales pendientes. Publicalos o sincronizalos antes de actualizar pesos.\n' >&2
  exit 1
}

if [[ -z "$python_command" ]]; then
  if [[ -x .venv/bin/python ]]; then
    python_command="$repo/.venv/bin/python"
  elif command -v python >/dev/null; then
    python_command=python
  else
    python_command=python3
  fi
fi
old_base=$(mktemp)
if [[ -f SPY_componentes_base.json ]]; then cp -- SPY_componentes_base.json "$old_base"; fi
printf 'Ejecutando script.py pesos con tu spy500.csv…\n'
"$python_command" script.py pesos
printf 'Actualizando los pesos visibles sin consultar precios…\n'
"$python_command" - "$old_base" <<'PY'
import json
import sys
from pathlib import Path
from weights import apply_weights

base_path = Path('SPY_componentes_base.json')
base = json.loads(base_path.read_text(encoding='utf-8'))
previous = Path(sys.argv[1]).read_bytes()
if previous:
    old = json.loads(previous)
    meaningful = lambda payload: {k: v for k, v in payload.items() if k != 'fecha_actualizacion'}
    if meaningful(old) == meaningful(base):
        base_path.write_bytes(previous)
output = Path('SPY_data.json')
feed = json.loads(output.read_text(encoding='utf-8'))
updated = apply_weights(feed, base['componentes'])
if updated != feed:
    temporary = output.with_suffix('.tmp')
    temporary.write_text(json.dumps(updated, ensure_ascii=False, indent=2) + '\n', encoding='utf-8')
    temporary.replace(output)
PY

git add -- spy500.csv SPY_componentes_base.json SPY_data.json
if git diff --cached --quiet; then
  printf 'No hay cambios para publicar.\n'
  exit 0
fi
git commit -m 'Actualizar pesos SPY desde CSV local'
git push origin HEAD:main
printf '\nPesos publicados en main. El hosting conectado al repositorio recibirá el cambio.\n'
